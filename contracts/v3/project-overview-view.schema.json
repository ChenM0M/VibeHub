{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/project-overview-view.schema.json",
  "title": "ProjectOverviewView",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "root", "scopes", "generated_at", "model_version", "freshness", "completeness", "repository", "model", "architecture", "active_tasks", "protocol_coverage", "evidence_refs", "warnings", "errors"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "project_id": { "$ref": "common.schema.json#/$defs/StableId" },
    "name": { "type": "string", "minLength": 1 },
    "root": { "$ref": "common.schema.json#/$defs/NativePath" },
    "scopes": { "$ref": "#/$defs/ProjectScopeInspection" },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "model_version": { "type": "string", "minLength": 1 },
    "freshness": { "$ref": "common.schema.json#/$defs/Freshness" },
    "completeness": { "$ref": "common.schema.json#/$defs/Completeness" },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "branch", "head", "dirty", "worktree_count"],
      "properties": {
        "state": { "enum": ["available", "not_repository", "unavailable"] },
        "branch": { "type": ["string", "null"] }, "head": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }, "worktree_count": { "type": "integer", "minimum": 0 }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "last_evidence_at", "generator_version", "indexed_files"],
      "properties": {
        "state": { "enum": ["uninitialized", "rebuilding", "ready", "error"] },
        "last_evidence_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
        "generator_version": { "type": "string" }, "indexed_files": { "type": "integer", "minimum": 0 }
      }
    },
    "architecture": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_docs", "modules", "relationships", "confidence", "evidence_refs"],
      "properties": {
        "declared_docs": { "type": "integer", "minimum": 0 }, "modules": { "type": "integer", "minimum": 0 },
        "relationships": { "type": "integer", "minimum": 0 }, "confidence": { "$ref": "common.schema.json#/$defs/Confidence" },
        "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" }
      }
    },
    "current_task_id": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "type": "null" }]
    },
    "current_default_task_id": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "type": "null" }]
    },
    "ui_selected_task_id": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "type": "null" }]
    },
    "session_bindings": {
      "type": "object",
      "additionalProperties": { "$ref": "session-task-routing.schema.json#/$defs/SessionTaskBinding" }
    },
    "active_tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "title", "intent", "workflow_profile", "state", "risk_level", "criteria", "active_sessions"],
        "properties": {
          "task_id": { "$ref": "common.schema.json#/$defs/StableId" }, "title": { "type": "string", "minLength": 1 },
          "intent": { "type": "string" }, "workflow_profile": { "enum": ["lightweight", "standard", "full"] },
          "state": { "enum": ["planned", "active", "blocked", "review", "completed", "cancelled", "closed_with_exceptions"] },
          "risk_level": { "enum": ["none", "low", "medium", "high", "critical"] },
          "criteria": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CriterionSummary" } },
          "blocker_details": { "$ref": "common.schema.json#/$defs/BlockerDetails" },
          "relations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["related_task_id", "relation_type", "confidence", "evidence_refs"], "properties": { "related_task_id": { "$ref": "common.schema.json#/$defs/StableId" }, "relation_type": { "type": "string", "minLength": 1 }, "confidence": { "$ref": "common.schema.json#/$defs/Confidence" }, "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" } } } },
          "active_sessions": { "type": "integer", "minimum": 0 }
          ,"is_current_default": { "type": "boolean" }, "is_ui_selected": { "type": "boolean" }
        }
      }
    },
    "archived_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/ArchivedTaskSummary" }
    },
    "archived_task_count": { "type": "integer", "minimum": 0 },
    "archived_tasks_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "default_limit"],
      "properties": {
        "surface": { "const": "task_archive_page" },
        "default_limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "protocol_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "opened_sessions", "closed_sessions", "gaps"],
      "properties": {
        "state": { "enum": ["complete", "partial", "gapped", "unknown"] },
        "opened_sessions": { "type": "integer", "minimum": 0 }, "closed_sessions": { "type": "integer", "minimum": 0 }, "gaps": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" },
    "warnings": { "$ref": "common.schema.json#/$defs/Warnings" },
    "errors": { "$ref": "common.schema.json#/$defs/Errors" }
  },
  "$defs": {
    "ProjectScopeInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_root", "execution_root", "git_root", "host_config_root", "source", "nested_repository", "warnings"],
      "properties": {
        "control_root": { "type": "string", "minLength": 1 },
        "execution_root": { "type": "string", "minLength": 1 },
        "git_root": { "type": ["string", "null"] },
        "host_config_root": { "type": "string", "minLength": 1 },
        "source": { "enum": ["control_root", "detected_git_root", "session_working_directory", "ambiguous"] },
        "nested_repository": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "CompletionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_event_id", "proposed_at_version", "digest", "valid", "confirmed", "confirmed_at_version", "confirmed_by", "channel"],
      "properties": {
        "proposal_event_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "type": "null" }] },
        "proposed_at_version": { "type": ["integer", "null"], "minimum": 1 },
        "digest": { "type": ["string", "null"] },
        "valid": { "type": "boolean" },
        "confirmed": { "type": "boolean" },
        "confirmed_at_version": { "type": ["integer", "null"], "minimum": 1 },
        "confirmed_by": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"] }
      }
    },
    "ArchivedTaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "intent", "state", "risk_level", "terminal_at", "completion", "closure", "criteria", "blocker_details", "plan", "sessions", "findings", "result", "evidence_count", "evidence_refs", "next_action", "source"],
      "properties": {
        "task_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "title": { "type": "string", "minLength": 1 },
        "intent": { "type": "string" },
        "state": { "enum": ["completed", "cancelled", "closed_with_exceptions"] },
        "risk_level": { "enum": ["none", "low", "medium", "high", "critical"] },
        "terminal_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
        "completion": { "$ref": "#/$defs/CompletionSummary" },
        "closure": { "type": "object", "additionalProperties": false, "required": ["method", "actor", "confirmed_by", "channel", "confirmed_at", "reason", "criteria_snapshot", "unresolved_items"], "properties": { "method": { "type": ["string", "null"], "enum": ["all_green", "with_exceptions", null] }, "actor": { "type": ["string", "null"] }, "confirmed_by": { "type": ["string", "null"] }, "channel": { "type": ["string", "null"] }, "confirmed_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] }, "reason": { "type": ["string", "null"] }, "criteria_snapshot": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CriterionSummary" } }, "unresolved_items": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" } } } },
        "criteria": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CriterionSummary" } },
        "blocker_details": { "$ref": "common.schema.json#/$defs/BlockerDetails" },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "completed", "cancelled", "active", "blocked", "planned"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "integer", "minimum": 0 },
            "active": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "planned": { "type": "integer", "minimum": 0 }
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "opened", "closed", "gapped"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "opened": { "type": "integer", "minimum": 0 },
            "closed": { "type": "integer", "minimum": 0 },
            "gapped": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "open", "closed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "open": { "type": "integer", "minimum": 0 },
            "closed": { "type": "integer", "minimum": 0 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "artifact_count", "recorded_at"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "summary": { "type": ["string", "null"] },
            "artifact_count": { "type": "integer", "minimum": 0 },
            "recorded_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] }
          }
        },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" },
        "next_action": { "type": "string", "minLength": 1 },
        "source": { "const": "v3_projection" }
      }
    }
  }
}
