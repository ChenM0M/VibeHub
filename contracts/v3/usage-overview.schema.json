{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/contracts/v3/1.0/usage-overview.schema.json",
  "title": "UsageOverview",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "model_version", "project_path", "scope", "generated_at", "freshness", "completeness", "refresh", "audit", "total_tokens", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "model_version": { "type": "string", "minLength": 1 },
    "project_path": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["project", "task"] },
    "task_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "completeness": { "enum": ["complete", "partial", "empty", "unavailable"] },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "refresh": { "$ref": "#/$defs/UsageRefreshSummary" },
    "audit": { "$ref": "#/$defs/UsageAuditSummary" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "OptionalCount": { "type": ["integer", "null"], "minimum": 0 },
    "UsageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "provider", "source_record_id", "model", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "total_tokens", "cost", "currency", "pricing_version", "captured_at", "freshness", "confidence", "dedupe_key", "evidence_provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "provider": { "type": "string", "minLength": 1 },
        "account_principal": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "source_record_id": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "input_tokens": { "$ref": "#/$defs/OptionalCount" },
        "output_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cache_read_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cache_write_tokens": { "$ref": "#/$defs/OptionalCount" },
        "reasoning_tokens": { "$ref": "#/$defs/OptionalCount" },
        "total_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "pricing_version": { "type": ["string", "null"] },
        "captured_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "confidence": { "type": "string", "minLength": 1 },
        "dedupe_key": { "type": "string", "minLength": 1 },
        "evidence_provenance": { "type": "string", "minLength": 1 }
      }
    },
    "UsageAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_by", "group_id", "record_count", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "total_tokens", "cost", "currency", "freshness", "confidence"],
      "properties": {
        "group_by": { "enum": ["project", "task", "session", "provider", "model", "time"] },
        "group_id": { "type": "string" },
        "record_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "$ref": "#/$defs/OptionalCount" },
        "output_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cache_read_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cache_write_tokens": { "$ref": "#/$defs/OptionalCount" },
        "reasoning_tokens": { "$ref": "#/$defs/OptionalCount" },
        "total_tokens": { "$ref": "#/$defs/OptionalCount" },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "confidence": { "type": "string" }
      }
    },
    "UsageRefreshSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "duration_ms", "performance_budget_ms", "within_budget", "cache_state"],
      "properties": {
        "state": { "enum": ["loading", "success", "partial", "failure", "cancelled"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "performance_budget_ms": { "type": "integer", "minimum": 1 },
        "within_budget": { "type": "boolean" },
        "cache_state": { "type": "string", "minLength": 1 }
      }
    },
    "UsageCostSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "known_cost", "currency", "pricing_version", "priced_tokens", "unpriced_tokens", "missing_reasons", "repair_actions"],
      "properties": {
        "state": { "enum": ["complete", "partial", "unknown"] },
        "known_cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "minLength": 3 },
        "pricing_version": { "type": "string", "minLength": 1 },
        "priced_tokens": { "type": "integer", "minimum": 0 },
        "unpriced_tokens": { "type": "integer", "minimum": 0 },
        "missing_reasons": { "type": "array", "items": { "type": "string" } },
        "repair_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "UsageAuditSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "model_version", "pricing_version", "currency", "captured_at", "freshness", "confidence", "attribution", "dedupe_strategy", "token_state", "cost", "excluded_records", "ambiguous_records", "legacy_records", "unattributed_tokens", "time_range", "breakdowns", "evidence_provenance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "model_version": { "type": "string", "minLength": 1 },
        "pricing_version": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 3 },
        "captured_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "confidence": { "type": "string" },
        "attribution": { "type": "string" },
        "dedupe_strategy": { "type": "string" },
        "token_state": { "enum": ["known", "unknown", "partial"] },
        "cost": { "$ref": "#/$defs/UsageCostSummary" },
        "excluded_records": { "type": "integer", "minimum": 0 },
        "ambiguous_records": { "type": "integer", "minimum": 0 },
        "legacy_records": { "type": "integer", "minimum": 0 },
        "unattributed_tokens": { "type": "integer", "minimum": 0 },
        "time_range": {
          "type": "object",
          "required": ["from_ms", "to_ms"],
          "properties": {
            "from_ms": { "type": ["integer", "null"] },
            "to_ms": { "type": ["integer", "null"] }
          }
        },
        "breakdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id", "provider", "model", "records", "total_tokens", "cost", "status"],
            "properties": {
              "kind": { "enum": ["provider", "model", "task", "session", "time"] },
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "model": { "type": ["string", "null"] },
              "records": { "type": "integer", "minimum": 0 },
              "total_tokens": { "$ref": "#/$defs/OptionalCount" },
              "cost": { "type": ["number", "null"], "minimum": 0 },
              "status": { "type": "string" }
            }
          }
        },
        "anomaly": { "type": ["object", "null"] },
        "evidence_provenance": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
