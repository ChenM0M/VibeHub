{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/task-list-view.schema.json",
  "title": "TaskListView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "tasks",
    "total_count",
    "returned_count",
    "active_count",
    "archived_count",
    "project_task_count",
    "omitted_archived_count",
    "include_archived",
    "sort"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "project_id": { "$ref": "common.schema.json#/$defs/StableId" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/TaskSummary" } },
    "total_count": { "type": "integer", "minimum": 0 },
    "returned_count": { "type": "integer", "minimum": 0 },
    "active_count": { "type": "integer", "minimum": 0 },
    "archived_count": { "type": "integer", "minimum": 0 },
    "project_task_count": { "type": "integer", "minimum": 0 },
    "omitted_archived_count": { "type": "integer", "minimum": 0 },
    "include_archived": { "type": "boolean" },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "terminal_at_missing", "state_tie_breaker", "tie_breaker"],
      "properties": {
        "order": { "const": "non_terminal_first_then_terminal_at_desc" },
        "terminal_at_missing": { "const": "last" },
        "state_tie_breaker": { "const": "state_rank_ascending" },
        "tie_breaker": { "const": "task_id_ascending" }
      }
    }
  },
  "$defs": {
    "TaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "intent",
        "workflow_profile",
        "state",
        "is_terminal",
        "terminal_at",
        "criterion_pass_rate",
        "required_node_completion_rate",
        "active_session_count",
        "source"
      ],
      "properties": {
        "task_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "title": { "type": "string", "minLength": 1 },
        "intent": { "type": "string" },
        "workflow_profile": { "enum": ["lightweight", "standard", "full"] },
        "state": { "enum": ["planned", "active", "blocked", "review", "completed", "cancelled", "closed_with_exceptions"] },
        "is_terminal": { "type": "boolean" },
        "terminal_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
        "criterion_pass_rate": { "$ref": "#/$defs/PassRate" },
        "required_node_completion_rate": { "$ref": "#/$defs/CompletionRate" },
        "active_session_count": { "type": "integer", "minimum": 0 },
        "source": { "const": "v3_event_log_projection" }
      }
    },
    "PassRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "not_applicable", "effective_passed", "total", "ratio"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "effective_passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "CompletionRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "waived", "credited", "total", "ratio"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "waived": { "type": "integer", "minimum": 0 },
        "credited": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
