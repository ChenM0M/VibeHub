{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/node-brief.schema.json",
  "title": "NodeBrief",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "task_id", "node_id", "workflow_profile", "execution_policy", "generated_at", "model_version", "freshness", "completeness", "goal", "scope", "non_scope", "dependencies", "accepted_decisions", "project_memory", "protocol_records", "coverage_mode", "completion_gate", "research_summary", "criteria", "files", "validation_commands", "state", "next_intent", "budget", "source_versions", "protocol_coverage", "evidence_refs", "warnings", "errors"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" }, "project_id": { "$ref": "common.schema.json#/$defs/StableId" }, "task_id": { "$ref": "common.schema.json#/$defs/StableId" }, "node_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "const": "" }] },
    "workflow_profile": { "enum": ["lightweight", "standard", "full"] },
    "execution_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["recommended_profile", "effective_profile", "policy_version", "enforcement_epoch", "trigger_reasons", "milestone_policy", "planning_required", "review_required", "required_records", "upgrade_history"],
      "properties": {
        "recommended_profile": { "enum": ["lightweight", "standard", "full"] },
        "effective_profile": { "enum": ["lightweight", "standard", "full"] },
        "policy_version": { "type": "integer", "minimum": 0 },
        "enforcement_epoch": { "type": "string" },
        "trigger_reasons": { "type": "array", "items": { "type": "string" } },
        "override_record": { "type": ["object", "null"] },
        "upgrade_history": { "type": "array", "items": { "type": "object" } },
        "milestone_policy": { "enum": ["minimal", "standard", "full"] },
        "planning_required": { "type": "boolean" },
        "review_required": { "type": "boolean" },
        "required_records": { "type": "array", "items": { "enum": ["plan", "session", "progress", "result", "review", "risk_if_any"] }, "uniqueItems": true }
      }
    },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }, "model_version": { "type": "string", "minLength": 1 }, "freshness": { "$ref": "common.schema.json#/$defs/Freshness" }, "completeness": { "$ref": "common.schema.json#/$defs/Completeness" },
    "goal": { "type": "string", "minLength": 1 }, "scope": { "type": "array", "items": { "type": "string" } }, "non_scope": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" } }, "accepted_decisions": { "type": "array", "items": { "type": "string" } },
    "project_memory": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["entry_id", "kind", "source", "revision", "status", "evidence_refs", "content", "why_injected", "instructional", "security_boundary"], "properties": {
      "entry_id": { "$ref": "common.schema.json#/$defs/StableId" }, "kind": { "type": "string" }, "source": { "const": "project_memory" },
      "revision": { "type": "integer", "minimum": 1 }, "status": { "type": "string" }, "evidence_refs": { "type": "array", "items": { "type": "string" } },
      "content": { "type": "string" }, "why_injected": { "type": "string", "minLength": 1 }, "instructional": { "const": false }, "security_boundary": { "const": "untrusted_data_only" }
    } } },
    "protocol_records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["record", "status", "repair_action"], "properties": { "record": { "type": "string" }, "status": { "enum": ["complete", "missing"] }, "repair_action": { "type": ["string", "null"] } } } },
    "coverage_mode": { "enum": ["enforced", "legacy_degraded"] },
    "completion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_passed", "blocked_chain", "items"],
      "properties": {
        "all_passed": { "type": "boolean" },
        "blocked_chain": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "status", "passed", "reason_code", "summary", "expected_state", "observed_state", "satisfied_facts", "missing_facts", "blocker_ids", "repair_actions"],
            "properties": {
              "gate": { "type": "string", "minLength": 1 },
              "status": { "enum": ["satisfied", "blocked"] },
              "passed": { "type": "boolean" },
              "reason_code": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "expected_state": { "type": "string", "minLength": 1 },
              "observed_state": { "type": "string", "minLength": 1 },
              "satisfied_facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "missing_facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "blocker_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" }, "uniqueItems": true },
              "repair_actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "research_summary": { "type": "array", "items": { "type": "string" } }, "criteria": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CriterionSummary" } },
    "files": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/NativePath" } }, "validation_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "state": { "enum": ["planned", "ready", "active", "blocked", "review", "completed", "cancelled", "superseded"] },
    "task_state": { "enum": ["planned", "active", "blocked", "review", "completed", "cancelled", "closed_with_exceptions"] },
    "next_intent": { "type": "string" },
    "blocker_details": { "$ref": "common.schema.json#/$defs/BlockerDetails" },
    "execution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["session_ids", "worktree", "base_sha", "native_path", "dirty", "integration_state", "conflict_owner", "next_action"],
      "properties": {
        "session_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" }, "uniqueItems": true },
        "worktree": { "anyOf": [{ "$ref": "common.schema.json#/$defs/WorktreeRef" }, { "type": "null" }] },
        "base_sha": { "anyOf": [{ "$ref": "common.schema.json#/$defs/GitSha" }, { "type": "null" }] },
        "native_path": { "anyOf": [{ "$ref": "common.schema.json#/$defs/NativePath" }, { "type": "null" }] },
        "dirty": { "type": ["boolean", "null"] },
        "integration_state": { "enum": ["not_requested", "queued", "integrating", "integrated", "conflicted", "blocked"] },
        "conflict_owner": { "type": ["string", "null"] },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_tokens", "estimated_tokens", "truncated_sections"],
      "properties": { "max_tokens": { "type": "integer", "minimum": 1 }, "estimated_tokens": { "type": "integer", "minimum": 0 }, "truncated_sections": { "type": "array", "items": { "type": "string" } } }
    },
    "source_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "protocol_coverage": { "enum": ["complete", "partial", "gapped", "unknown"] }, "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" },
    "warnings": { "$ref": "common.schema.json#/$defs/Warnings" }, "errors": { "$ref": "common.schema.json#/$defs/Errors" }
  }
}
