{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/common.schema.json",
  "title": "VibeHub V3 Common Contract Vocabulary",
  "$defs": {
    "SchemaVersion": { "const": "1.0" },
    "StableId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Freshness": { "enum": ["fresh", "stale", "rebuilding", "unavailable"] },
    "Completeness": { "enum": ["complete", "partial", "unsupported", "unknown"] },
    "EvidenceGrade": { "enum": ["hard_observed", "agent_reported", "inferred", "user_confirmed"] },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "grade", "label_key", "locator"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["event", "file", "git", "command", "test", "user", "external"] },
        "grade": { "$ref": "#/$defs/EvidenceGrade" },
        "label_key": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "#/$defs/Timestamp" },
        "excerpt": { "type": "string" }
      }
    },
    "EvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" }, "uniqueItems": true },
    "RepairAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "label", "instructions", "owner", "preconditions", "verification", "copy_text"],
      "properties": {
        "action_id": { "$ref": "#/$defs/StableId" },
        "kind": { "enum": ["command", "manual", "navigate", "retry", "collect_evidence"] },
        "label": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "copy_text": { "type": "string", "minLength": 1 }
      }
    },
    "BlockerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_event_ids", "reconstructed_fields", "unknown_fields"],
      "properties": {
        "status": { "enum": ["native", "legacy", "degraded"] },
        "source_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reconstructed_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "unknown_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "BlockerDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "blocker_id", "reason_code", "source_type", "source_id", "summary", "why_blocked", "expected_state", "observed_state", "missing_facts", "impact", "kind", "owner", "preconditions", "repair_actions", "freshness", "provenance", "precondition", "resume_action", "evidence_refs"],
      "properties": {
        "model_version": { "const": "1.0" },
        "blocker_id": { "$ref": "#/$defs/StableId" },
        "reason_code": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["criterion", "finding", "session", "plan_node", "worktree", "lease", "integration", "task", "event", "unknown"] },
        "source_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "why_blocked": { "type": "string", "minLength": 1 },
        "expected_state": { "type": "string", "minLength": 1 },
        "observed_state": { "type": "string", "minLength": 1 },
        "missing_facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "impact": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["external_precondition", "permission", "evidence_gap", "dependency", "conflict", "workflow", "unknown"] },
        "owner": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "repair_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RepairAction" }, "uniqueItems": true },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "provenance": { "$ref": "#/$defs/BlockerProvenance" },
        "precondition": { "type": "string", "minLength": 1 },
        "resume_action": { "type": "string", "minLength": 1 },
        "criterion_id": { "$ref": "#/$defs/StableId" },
        "node_id": { "$ref": "#/$defs/StableId" },
        "evidence_refs": { "$ref": "#/$defs/EvidenceRefs" }
      }
    },
    "BlockerDetails": { "type": "array", "items": { "$ref": "#/$defs/BlockerDetail" }, "uniqueItems": true },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message_key", "evidence_refs"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message_key": { "type": "string", "minLength": 1 },
        "details": { "type": "object" },
        "evidence_refs": { "$ref": "#/$defs/EvidenceRefs" }
      }
    },
    "Warnings": { "type": "array", "items": { "$ref": "#/$defs/Warning" } },
    "StructuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "recoverable", "message_key", "evidence_refs"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "category": { "enum": ["validation", "not_found", "permission", "conflict", "unsupported", "internal"] },
        "recoverable": { "type": "boolean" },
        "message_key": { "type": "string", "minLength": 1 },
        "retry_after_ms": { "type": "integer", "minimum": 0 },
        "details": { "type": "object" },
        "evidence_refs": { "$ref": "#/$defs/EvidenceRefs" }
      }
    },
    "Errors": { "type": "array", "items": { "$ref": "#/$defs/StructuredError" } },
    "NativePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "native", "display", "identity_key"],
      "properties": {
        "platform": { "enum": ["macos", "windows", "linux", "unknown"] },
        "native": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "identity_key": { "type": "string", "minLength": 1 },
        "path_kind": { "enum": ["absolute", "drive", "unc", "extended", "relative"] },
        "accessible": { "type": ["boolean", "null"] },
        "symlink_target": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "platform": { "const": "windows" } }, "required": ["platform"] },
          "then": {
            "properties": {
              "native": { "type": "string", "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\)[^/]+$" },
              "display": { "type": "string", "pattern": "^[^\\\\]+$" }
            }
          }
        },
        {
          "if": { "properties": { "platform": { "const": "macos" } }, "required": ["platform"] },
          "then": { "properties": { "native": { "type": "string", "pattern": "^/" } } }
        }
      ]
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "next_cursor", "limit", "returned", "total_estimate", "truncated", "truncation_reason", "model_version"],
      "properties": {
        "cursor": { "type": ["string", "null"] },
        "next_cursor": { "type": ["string", "null"] },
        "limit": { "type": "integer", "minimum": 1 },
        "returned": { "type": "integer", "minimum": 0 },
        "total_estimate": { "type": ["integer", "null"], "minimum": 0 },
        "truncated": { "type": "boolean" },
        "truncation_reason": { "enum": ["none", "page_limit", "size_budget", "permission", "unsupported"] },
        "model_version": { "type": "string", "minLength": 1 }
      }
    },
    "Confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "GitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "WorktreeState": {
      "enum": ["planned", "creating", "ready", "active", "dirty", "submitted", "integrating", "integrated", "conflicted", "abandoned", "repairing", "cleaned"]
    },
    "EligibilityDecision": { "enum": ["allow", "warn", "block"] },
    "IntegrationPolicy": { "enum": ["merge_no_ff", "rebase", "cherry_pick"] },
    "WorktreeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_id", "lease_id", "branch", "state"],
      "properties": {
        "worktree_id": { "$ref": "#/$defs/StableId" },
        "lease_id": { "anyOf": [{ "$ref": "#/$defs/StableId" }, { "type": "null" }] },
        "branch": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/WorktreeState" }
      }
    },
    "CriterionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "title", "status", "required", "evidence_refs"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/StableId" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "accepted", "passed", "failed", "blocked", "not_applicable"] },
        "required": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/EvidenceRefs" }
      }
    }
  }
}
