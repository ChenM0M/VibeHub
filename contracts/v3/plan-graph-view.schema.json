{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/plan-graph-view.schema.json",
  "title": "PlanGraphView",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "task_id", "plan_version", "workflow_profile", "planning_required", "generated_at", "model_version", "freshness", "completeness", "graph_state", "nodes", "scheduling_edges", "trace_relations", "execution", "evidence_refs", "warnings", "errors"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" }, "project_id": { "$ref": "common.schema.json#/$defs/StableId" }, "task_id": { "$ref": "common.schema.json#/$defs/StableId" },
    "plan_version": { "type": "integer", "minimum": 0 }, "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }, "model_version": { "type": "string", "minLength": 1 },
    "workflow_profile": { "enum": ["lightweight", "standard", "full"] }, "planning_required": { "type": "boolean" },
    "freshness": { "$ref": "common.schema.json#/$defs/Freshness" }, "completeness": { "$ref": "common.schema.json#/$defs/Completeness" },
    "graph_state": { "enum": ["valid", "cycle", "unknown_node", "changed", "stale"] },
    "nodes": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "title", "goal", "state", "readiness", "block_reasons", "scope", "criterion_ids"],
        "properties": {
          "node_id": { "$ref": "common.schema.json#/$defs/StableId" }, "title": { "type": "string", "minLength": 1 }, "goal": { "type": "string", "minLength": 1 },
          "state": { "enum": ["planned", "ready", "active", "blocked", "review", "completed", "cancelled", "superseded"] },
          "readiness": { "enum": ["ready", "blocked", "unknown"] }, "block_reasons": { "type": "array", "items": { "type": "string" } },
          "blocker_details": { "$ref": "common.schema.json#/$defs/BlockerDetails" },
          "scope": { "type": "array", "items": { "type": "string" } }, "criterion_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" } },
          "session_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" }, "uniqueItems": true },
          "agent_result_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/StableId" }, "uniqueItems": true },
          "parallel_layer": { "type": "integer", "minimum": 0 },
          "parallel_candidate": { "type": "boolean" },
          "execution_state": { "enum": ["not_started", "session_active", "observed", "succeeded", "failed"] },
          "worktree": { "anyOf": [{ "$ref": "common.schema.json#/$defs/WorktreeRef" }, { "type": "null" }] }
        }
      }
    },
    "scheduling_edges": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["edge_id", "from_node_id", "to_node_id", "kind"],
        "properties": { "edge_id": { "$ref": "common.schema.json#/$defs/StableId" }, "from_node_id": { "$ref": "common.schema.json#/$defs/StableId" }, "to_node_id": { "$ref": "common.schema.json#/$defs/StableId" }, "kind": { "const": "depends_on" } }
      }
    },
    "trace_relations": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["relation_id", "from_id", "to_id", "kind", "evidence_refs"],
        "properties": { "relation_id": { "$ref": "common.schema.json#/$defs/StableId" }, "from_id": { "$ref": "common.schema.json#/$defs/StableId" }, "to_id": { "$ref": "common.schema.json#/$defs/StableId" }, "kind": { "enum": ["repairs", "addresses", "validates", "supersedes"] }, "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["planned_sessions", "observed_sessions", "planned_worktrees", "observed_worktrees"],
      "properties": { "planned_sessions": { "type": "integer", "minimum": 0 }, "observed_sessions": { "type": "integer", "minimum": 0 }, "planned_worktrees": { "type": "integer", "minimum": 0 }, "observed_worktrees": { "type": "integer", "minimum": 0 } }
    },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/EvidenceRefs" }, "warnings": { "$ref": "common.schema.json#/$defs/Warnings" }, "errors": { "$ref": "common.schema.json#/$defs/Errors" }
  }
}
