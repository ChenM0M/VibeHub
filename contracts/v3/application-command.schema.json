{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/application-command.schema.json",
  "title": "V3ApplicationCommand",
  "oneOf": [
    { "$ref": "#/$defs/SessionOpen" },
    { "$ref": "#/$defs/EventLog" },
    { "$ref": "#/$defs/SessionClose" },
    { "$ref": "#/$defs/WorktreeCommand" },
    { "$ref": "#/$defs/Rebuild" }
  ],
  "$defs": {
    "WriteScope": {
      "type": "object",
      "required": ["project_id", "task_id", "session_id", "actor", "expected_version", "idempotency_key"],
      "properties": {
        "project_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "task_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "session_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "actor": { "type": "string", "minLength": 1 },
        "expected_version": { "type": "integer", "minimum": 0 },
        "idempotency_key": { "$ref": "common.schema.json#/$defs/StableId" }
      }
    },
    "SessionOpen": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/WriteScope" },
        { "type": "object", "required": ["command"], "properties": { "command": { "const": "session_open" } } }
      ]
    },
    "EventLog": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/WriteScope" },
        {
          "type": "object",
          "required": ["command", "kind", "details"],
          "properties": {
            "command": { "const": "event_log" },
            "kind": { "enum": ["progress", "risk"] },
            "details": { "type": "object" }
          }
        }
      ]
    },
    "SessionClose": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/WriteScope" },
        { "type": "object", "required": ["command"], "properties": { "command": { "const": "session_close" } } }
      ]
    },
    "WorktreeCommand": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/WriteScope" },
        {
          "type": "object",
          "required": ["command", "node_id", "worktree_id", "operation_id", "eligibility_digest"],
          "properties": {
            "command": {
              "enum": [
                "worktree_plan", "worktree_create", "worktree_activate", "worktree_mark_dirty",
                "worktree_submit", "worktree_integrate", "worktree_repair", "worktree_abandon", "worktree_clean",
                "lease_acquire", "lease_heartbeat", "lease_release", "lease_reclaim"
              ]
            },
            "node_id": { "$ref": "common.schema.json#/$defs/StableId" },
            "worktree_id": { "$ref": "common.schema.json#/$defs/StableId" },
            "lease_id": { "$ref": "common.schema.json#/$defs/StableId" },
            "operation_id": { "$ref": "common.schema.json#/$defs/StableId" },
            "eligibility_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "lease_generation": { "type": "integer", "minimum": 1 },
            "integration_policy": { "$ref": "common.schema.json#/$defs/IntegrationPolicy" },
            "details": { "type": "object" }
          }
        }
      ]
    },
    "Rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "project_id"],
      "properties": {
        "command": { "const": "rebuild" },
        "project_id": { "$ref": "common.schema.json#/$defs/StableId" }
      }
    }
  }
}
