{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/project-settings.schema.json",
  "title": "V3ProjectSettingsContract",
  "oneOf": [
    { "$ref": "#/$defs/V3ProjectSettingsInspection" },
    { "$ref": "#/$defs/V3ProjectSettingsUpdateRequest" },
    { "$ref": "#/$defs/V3ProjectSettings" }
  ],
  "$defs": {
    "V3OutputLanguage": { "enum": ["zh-CN", "zh-TW", "en-US"] },
    "V3AgentSpecTarget": { "enum": ["claude_code", "opencode", "codex"] },
    "V3ProjectSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "revision",
        "output_language",
        "agent_spec_targets",
        "updated_at",
        "updated_by"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "v3_project_settings" },
        "revision": { "type": "integer", "minimum": 1 },
        "output_language": { "$ref": "#/$defs/V3OutputLanguage" },
        "agent_spec_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/V3AgentSpecTarget" }
        },
        "repository_remote_url": { "type": ["string", "null"] },
        "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updated_by": { "type": "string", "minLength": 1 }
      }
    },
    "V3ProjectSettingsInspection": {
      "type": "object",
      "required": ["status", "settings", "recommended_action"],
      "properties": {
        "status": { "enum": ["missing", "present"] },
        "settings": {
          "oneOf": [
            { "$ref": "#/$defs/V3ProjectSettings" },
            { "type": "null" }
          ]
        },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "V3ProjectSettingsUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision", "output_language", "agent_spec_targets"],
      "properties": {
        "expected_revision": { "type": "integer", "minimum": 0 },
        "output_language": { "$ref": "#/$defs/V3OutputLanguage" },
        "agent_spec_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/V3AgentSpecTarget" }
        },
        "repository_remote_url": { "type": ["string", "null"] }
      }
    }
  }
}
