{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/task-create.schema.json",
  "title": "V3TaskCreateContract",
  "oneOf": [
    { "$ref": "#/$defs/V3TaskCreateRequest" },
    { "$ref": "#/$defs/V3TaskCreateResult" }
  ],
  "$defs": {
    "V3TaskCreateRequest": {
      "type": "object",
      "required": ["title", "intent", "acceptance_criteria"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "intent": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "workflow_profile": { "enum": ["lightweight", "standard", "full"], "default": "standard" },
        "trigger_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dependencies": { "type": "array", "items": { "type": "string" } },
            "handoff_required": { "type": "boolean" }, "multi_agent": { "type": "boolean" },
            "cross_platform": { "type": "boolean" }, "release": { "type": "boolean" },
            "migration": { "type": "boolean" }, "security_sensitive": { "type": "boolean" }
          }
        },
        "profile_override": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["requested_profile", "reason", "user_confirmed"],
          "properties": {
            "requested_profile": { "enum": ["lightweight", "standard", "full"] },
            "reason": { "type": "string", "minLength": 1 },
            "user_confirmed": { "const": true }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "V3TaskCreateResult": {
      "type": "object",
      "required": [
        "status",
        "task_id",
        "task_path",
        "current_pointer_path",
        "initial_node_id",
        "lifecycle_version"
      ],
      "properties": {
        "status": { "enum": ["created", "already_exists"] },
        "task_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "task_path": { "type": "string", "minLength": 1 },
        "current_pointer_path": { "type": "string", "minLength": 1 },
        "initial_node_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/StableId" }, { "type": "null" }] },
        "lifecycle_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
