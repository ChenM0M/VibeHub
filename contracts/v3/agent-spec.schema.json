{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/agent-spec.schema.json",
  "title": "V3AgentSpecContract",
  "oneOf": [
    { "$ref": "#/$defs/V3AgentSpecInspection" },
    { "$ref": "#/$defs/V3AgentSpecSyncRequest" },
    { "$ref": "#/$defs/V3AgentSpecSyncResult" }
  ],
  "$defs": {
    "AgentSpecTarget": { "enum": ["claude_code", "opencode", "codex"] },
    "V3AgentSpecArtifactStatus": {
      "enum": ["missing", "in_sync", "outdated", "modified_outside", "unsupported"]
    },
    "V3AgentSpecArtifactInspection": {
      "type": "object",
      "required": [
        "path",
        "consumers",
        "status",
        "reason",
        "current_hash",
        "desired_hash",
        "last_written_hash"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AgentSpecTarget" }
        },
        "status": { "$ref": "#/$defs/V3AgentSpecArtifactStatus" },
        "reason": { "type": "string", "minLength": 1 },
        "current_hash": { "type": ["string", "null"] },
        "desired_hash": { "type": "string", "minLength": 1 },
        "last_written_hash": { "type": ["string", "null"] }
      }
    },
    "V3AgentSpecInspection": {
      "type": "object",
      "required": ["spec_version", "renderer_version", "settings_revision", "artifacts"],
      "properties": {
        "spec_version": { "type": "string", "minLength": 1 },
        "renderer_version": { "type": "string", "minLength": 1 },
        "settings_revision": { "type": "integer", "minimum": 1 },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/V3AgentSpecArtifactInspection" }
        }
      }
    },
    "V3AgentSpecSyncRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "force_managed_region": { "type": "boolean", "default": false }
      }
    },
    "V3AgentSpecSyncResult": {
      "type": "object",
      "required": ["inspection", "written_paths", "skipped_paths"],
      "properties": {
        "inspection": { "$ref": "#/$defs/V3AgentSpecInspection" },
        "written_paths": { "type": "array", "items": { "type": "string" } },
        "skipped_paths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
