{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibehub.dev/v3/1.0/agent-spec.schema.json",
  "title": "V3AgentSpecContract",
  "oneOf": [
    { "$ref": "#/$defs/V3AgentSpecInspection" },
    { "$ref": "#/$defs/V3AgentSpecSyncRequest" },
    { "$ref": "#/$defs/V3AgentSpecSyncResult" }
  ],
  "$defs": {
    "AgentSpecTarget": { "enum": ["claude_code", "opencode", "codex"] },
    "V3AgentSpecArtifactStatus": {
      "enum": ["missing", "in_sync", "outdated", "modified_outside", "legacy_migratable", "unsupported"]
    },
    "V3AgentSpecSyncStatus": {
      "enum": ["synchronized", "incomplete"]
    },
    "V3AgentSpecArtifactInspection": {
      "type": "object",
      "required": [
        "path",
        "consumers",
        "status",
        "reason",
        "current_hash",
        "desired_hash",
        "last_written_hash"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AgentSpecTarget" }
        },
        "status": { "$ref": "#/$defs/V3AgentSpecArtifactStatus" },
        "reason": { "type": "string", "minLength": 1 },
        "current_hash": { "type": ["string", "null"] },
        "desired_hash": { "type": "string", "minLength": 1 },
        "last_written_hash": { "type": ["string", "null"] }
      }
    },
    "ProjectScopeInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_root", "execution_root", "git_root", "host_config_root", "source", "nested_repository", "warnings"],
      "properties": {
        "control_root": { "type": "string", "minLength": 1 },
        "execution_root": { "type": "string", "minLength": 1 },
        "git_root": { "type": ["string", "null"] },
        "host_config_root": { "type": "string", "minLength": 1 },
        "source": { "enum": ["control_root", "detected_git_root", "session_working_directory", "ambiguous"] },
        "nested_repository": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "EffectiveAgentDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "consumers", "precedence", "exists", "contains_v3_region"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/AgentSpecTarget" }, "uniqueItems": true },
        "precedence": { "type": "integer", "minimum": 0 },
        "exists": { "type": "boolean" },
        "contains_v3_region": { "type": "boolean" }
      }
    },
    "McpHostConfigInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "path", "status", "reason", "server_name", "configured_project_root"],
      "properties": {
        "consumer": { "$ref": "#/$defs/AgentSpecTarget" },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["missing", "in_sync", "mismatched", "invalid"] },
        "reason": { "type": "string", "minLength": 1 },
        "server_name": { "type": ["string", "null"] },
        "configured_project_root": { "type": ["string", "null"] }
      }
    },
    "V3AgentSpecInspection": {
      "type": "object",
      "required": ["spec_version", "renderer_version", "settings_revision", "scope", "effective_declarations", "mcp_hosts", "artifacts"],
      "properties": {
        "spec_version": { "type": "string", "minLength": 1 },
        "renderer_version": { "type": "string", "minLength": 1 },
        "settings_revision": { "type": "integer", "minimum": 1 },
        "scope": { "$ref": "#/$defs/ProjectScopeInspection" },
        "effective_declarations": { "type": "array", "items": { "$ref": "#/$defs/EffectiveAgentDeclaration" } },
        "mcp_hosts": { "type": "array", "items": { "$ref": "#/$defs/McpHostConfigInspection" } },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/V3AgentSpecArtifactInspection" }
        }
      }
    },
    "V3AgentSpecSyncRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "force_managed_region": { "type": "boolean", "default": false }
      }
    },
    "V3AgentSpecSyncResult": {
      "type": "object",
      "required": ["status", "inspection", "written_paths", "skipped_paths", "blocking_paths"],
      "properties": {
        "status": { "$ref": "#/$defs/V3AgentSpecSyncStatus" },
        "inspection": { "$ref": "#/$defs/V3AgentSpecInspection" },
        "written_paths": { "type": "array", "items": { "type": "string" } },
        "skipped_paths": { "type": "array", "items": { "type": "string" } },
        "blocking_paths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
