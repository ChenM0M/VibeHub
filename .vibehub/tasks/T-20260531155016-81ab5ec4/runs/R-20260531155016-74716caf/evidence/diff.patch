+function ProjectTaskCardLinear({
+    task,
+    status,
+    currentFlow,
+    focusedTarget,
+    onOpenDetail,
+    onOpenPhase,
+    t,
+}: any) {
+    const steps = getTaskProcessSteps(task, status, currentFlow);
+    const shortLabel = getTaskShortLabel(task, t);
+    const hasSharedFiles = task.shared_files.length > 0;
+    const taskFocused = focusedTarget?.taskId === task.task_id;
+    
+    // Linear-style minimalist active card:
+    // Darker background, border-left emphasis for current task, no visible full border unless focused.
+    return (
+        <div className={`group relative rounded-2xl bg-muted/10 p-4 transition-all hover:bg-muted/30
+            ${taskFocused ? 'ring-2 ring-primary/20 bg-primary/5' : ''}
+            ${task.current ? 'border-l-4 border-l-primary/60 pl-3 bg-muted/20' : 'border-l-4 border-l-transparent'}
+        `}>
+            <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
+                
+                {/* Left side: Task Intent / Requirement Summary */}
+                <button
+                    type="button"
+                    onClick={() => onOpenDetail('task')}
+                    className="flex-1 min-w-0 text-left focus-visible:outline-none"
+                >
+                    <div className="flex items-start gap-4">
+                        <div className="shrink-0 flex h-10 min-w-12 max-w-20 items-center justify-center rounded-xl bg-muted/50 px-2 text-sm font-medium text-foreground/80">
+                            <span className="truncate">{shortLabel}</span>
+                        </div>
+                        <div className="min-w-0 flex-1 pt-0.5">
+                            <div className="flex flex-wrap items-center gap-2 mb-1">
+                                <span className="truncate text-base font-medium leading-tight group-hover:text-primary transition-colors">{task.title || task.task_id}</span>
+                                {task.current && <Badge variant="secondary" className="rounded-full px-2 py-0 h-5 text-[10px] font-medium bg-primary/10 text-primary border-none uppercase tracking-wide">{labelOrFallback(t, 'vibehub.kanban.current', 'Current')}</Badge>}
+                                {task.intake_order && <span className="text-xs text-muted-foreground/60 font-medium">#{task.intake_order}</span>}
+                            </div>
+                            <div className="font-mono text-[11px] text-muted-foreground/50 tracking-tight">
+                                {task.task_id}{task.run_id ? ` · ${task.run_id}` : ''}
+                            </div>
+                            {task.dependencies.length > 0 && (
+                                <div className="mt-2.5 flex flex-wrap gap-1.5">
+                                    {task.dependencies.slice(0, 3).map((dependency: string) => (
+                                        <div key={dependency} className="rounded-md bg-muted/50 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground/80">{dependency}</div>
+                                    ))}
+                                </div>
+                            )}
+                        </div>
+                    </div>
+                </button>
+
+                {/* Right side: Process Strip */}
+                <div
+                    role="button"
+                    tabIndex={0}
+                    onClick={() => onOpenPhase(task.phase || status.current_phase || null)}
+                    onKeyDown={(event) => {
+                        if (event.key === 'Enter' || event.key === ' ') onOpenPhase(task.phase || status.current_phase || null);
+                    }}
+                    className="shrink-0 lg:max-w-[45%] rounded-xl bg-transparent p-2 transition-colors hover:bg-muted/30 focus-visible:outline-none"
+                >
+                    <div className="flex items-center gap-1.5 overflow-x-auto no-scrollbar mask-fade-edges">
+                        {steps.map((step: any, index: number) => (
+                            <LinearProcessPill
+                                key={`${task.task_id}:${step.phase || index}:${step.kind}`}
+                                step={step}
+                                focused={Boolean(taskFocused && focusedTarget?.capability && focusedTarget.capability === step.phase)}
+                                onOpenPhase={onOpenPhase}
+                                t={t}
+                            />
+                        ))}
+                    </div>
+                    {hasSharedFiles && (
+                        <div className="mt-2 text-[11px] text-amber-600 dark:text-amber-400 font-medium tracking-wide">
+                            {labelOrFallback(t, 'vibehub.kanban.sharedFiles', 'Shared')}: {task.shared_files.slice(0, 3).join(', ')}
+                        </div>
+                    )}
+                </div>
+            </div>
+        </div>
+    );
+}
+
+function LinearProcessPill({
+    step,
+    focused,
+    onOpenPhase,
+    t,
+}: any) {
+    if (step.kind === 'ellipsis') {
+        return <span className="shrink-0 px-2 text-[10px] text-muted-foreground/40 font-mono tracking-widest">•••</span>;
+    }
+    const active = step.status === 'active' || step.status === 'running';
+    const isCompleted = step.status === 'completed';
+    
+    // Linear style phase pill: Minimalist text, subtle background, distinct active state.
+    return (
+        <button
+            type="button"
+            onClick={(event) => {
+                event.stopPropagation();
+                onOpenPhase(step.phase);
+            }}
+            className={`shrink-0 rounded-full px-3 py-1 text-xs font-medium transition-all focus-visible:outline-none
+                ${focused ? 'bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20' 
+                : active ? 'bg-foreground text-background shadow-sm' 
+                : isCompleted ? 'bg-muted/40 text-muted-foreground hover:bg-muted/60 hover:text-foreground'
+                : 'bg-transparent text-muted-foreground/60 border border-muted/50 hover:bg-muted/20'}
+            `}
+        >
+            {step.phase ? t(`vibehub.capability.${step.phase}`, { defaultValue: step.phase }) : t('common.unknown')}
+        </button>
+    );
+}
