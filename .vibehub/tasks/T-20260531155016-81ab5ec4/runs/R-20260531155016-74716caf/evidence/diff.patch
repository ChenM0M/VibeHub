+                        
+                        {/* 
+                            For this aesthetic mockup, we render nodes in a flow layout.
+                            A real graph renderer (like react-flow or d3) would compute positions.
+                            Since we just have a flat array of nodes, we will layout them pseudo-randomly or circularly. 
+                        */}
+                        <div className="flex flex-wrap items-center justify-center p-20 gap-8 min-w-[800px] min-h-[600px]">
+                            {nodes.length > 0 ? nodes.map((node, i) => (
+                                <GraphNode key={node.id} node={node} index={i} total={nodes.length} />
+                            )) : (
+                                <div className="text-sm text-muted-foreground/50">
+                                    {labelOrFallback(t, 'vibehub.projectMap.structureEmpty', 'No structure data found.')}
+                                </div>
+                            )}
+                        </div>
+                    </div>
+                </div>
+
+                {/* Right side Directory Tree Panel */}
+                <div className="w-80 border-l border-border/40 bg-background/50 backdrop-blur-md flex flex-col z-10">
+                    <div className="p-4 border-b border-border/40">
+                        <h4 className="text-sm font-medium tracking-wide uppercase text-muted-foreground">Files</h4>
+                    </div>
+                    <div className="flex-1 overflow-y-auto p-3 no-scrollbar">
+                        {tree.length > 0 ? tree.map(node => (
+                            <DirectoryTreeNode key={node.path} node={node} level={0} />
+                        )) : (
+                            <div className="text-xs text-muted-foreground/50 p-4 text-center">No directory data</div>
+                        )}
+                    </div>
+                </div>
+            </div>
+        </div>
+    );
+}
+
+// Internal sub-components
+
+function GraphNode({ node, index, total }: { node: VibehubProjectStructureGraphNode, index: number, total: number }) {
+    // Generate a pseudo position just for mockup purposes. 
+    // In real usage, coordinates should come from layout engine.
+    const radius = 250;
+    const angle = (index / total) * 2 * Math.PI;
+    const x = Math.cos(angle) * radius;
+    const y = Math.sin(angle) * radius;
+
+    return (
+        <div 
+            className={`absolute flex flex-col items-center justify-center gap-2 p-4 rounded-2xl border transition-all hover:scale-105 shadow-sm
+                ${node.changed ? 'bg-primary/10 border-primary/30 text-primary' : 'bg-background border-border/40 text-foreground'}
+            `}
+            style={{ 
+                left: `calc(50% + ${x}px)`, 
+                top: `calc(50% + ${y}px)`,
+                transform: 'translate(-50%, -50%)',
+                width: '180px'
+            }}
+        >
+            <div className={`h-10 w-10 rounded-full flex items-center justify-center ${node.changed ? 'bg-primary/20' : 'bg-muted/50'}`}>
+                {node.kind === 'root' ? <Boxes className="h-5 w-5" /> : <Folder className="h-5 w-5" />}
+            </div>
+            <div className="text-sm font-semibold truncate w-full text-center">{node.label}</div>
+            <div className="text-[10px] text-muted-foreground/70 truncate w-full text-center" title={node.path}>{node.path}</div>
+
+        </div>
+    );
+}
+
+function DirectoryTreeNode({ node, level }: { node: VibehubProjectStructureTreeNode, level: number }) {
+    const [expanded, setExpanded] = useState(level < 1);
+    const isDir = node.kind === 'directory';
+
+    return (
+        <div className="select-none">
+            <div 
+                className={`flex items-center gap-2 py-1.5 px-2 rounded-lg hover:bg-muted/40 cursor-pointer text-sm
+                    ${node.changed ? 'text-primary font-medium' : 'text-foreground/80'}
+                `}
+                style={{ paddingLeft: `${(level * 12) + 8}px` }}
+                onClick={() => isDir && setExpanded(!expanded)}
+            >
+                <span className="w-4 h-4 flex items-center justify-center shrink-0 opacity-70">
+                    {isDir ? (expanded ? <ChevronDown className="w-3.5 h-3.5" /> : <ChevronRight className="w-3.5 h-3.5" />) : null}
+                </span>
+                <span className="shrink-0">
+                    {isDir ? <Folder className="w-4 h-4 text-amber-500/80" /> : <File className="w-3.5 h-3.5 text-muted-foreground/60" />}
+                </span>
+                <span className="truncate flex-1" title={node.label}>{node.label}</span>
+            </div>
+            
+            {isDir && expanded && node.children && (
+                <div className="mt-0.5">
+                    {node.children.map(child => (
+                        <DirectoryTreeNode key={child.path} node={child} level={level + 1} />
+                    ))}
+                </div>
+            )}
+        </div>
+    );
+}
