+
+    const DIGEST: &str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+
+    fn command(event_type: &str, version: u64, key: &str) -> OrchestrationCommand {
+        OrchestrationCommand {
