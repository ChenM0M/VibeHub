+++pub const ORCHESTRATION_EVENT_TYPES: &[&str] = &[
+++    "worktree.planned",
+++    "worktree.create_prepared",
+++    "worktree.ready",
+++    "worktree.activated",
+++    "worktree.dirty",
+++    "worktree.submitted",
