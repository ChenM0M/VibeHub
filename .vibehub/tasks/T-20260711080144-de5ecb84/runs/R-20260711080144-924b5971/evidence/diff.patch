++pub fn parse_worktree_porcelain(output: &str) -> Vec<GitWorktreeRecord> {
++    output
++        .split("\n\n")
++        .filter_map(|block| {
++            let mut native_path = None;
++            let mut record = GitWorktreeRecord {
