++        }
++        if self.reclaim_challenge.as_deref() != Some(challenge) || challenge.is_empty() {
++            return Err("LEASE_RECLAIM_CHALLENGE_MISMATCH");
++        }
++        Ok(Self {
++            generation: self.generation + 1,
++            reclaim_challenge: None,
++            ..self.clone()
++        })
++    }
++}
