+++                    file.sync_all().map_err(io_error("V3_LOCK_SYNC_FAILED"))?;
+++                    return Ok(Self {
+++                        path: path.to_owned(),
+++                    });
+++                }
+++                Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+++                    let owner_is_dead = lock_owner_pid(path).is_some_and(|pid| !process_alive(pid));
