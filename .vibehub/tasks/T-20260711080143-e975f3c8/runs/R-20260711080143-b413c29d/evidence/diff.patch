++fn lock_owner_pid(path: &Path) -> Option<u32> {
++    let content = fs::read_to_string(path).ok()?;
++    content
++        .split_whitespace()
++        .find_map(|field| field.strip_prefix("pid="))?
++        .parse()
++        .ok()
++}
