+++++          animated: true,
+++++          markerEnd: { type: MarkerType.ArrowClosed, width: 24, height: 24, color: edgeActiveColor },
+++++        };
+++++      }
+++++      
+++++      // Past edge (completed path)
+++++      if (isTargetDone) {
+++++        return {
+++++          id: e.edge_id, source: e.from_node_id, target: e.to_node_id,
+++++          type: "smoothstep",
+++++          style: { stroke: edgeDoneColor, strokeWidth: 2 },
+++++          animated: false,
