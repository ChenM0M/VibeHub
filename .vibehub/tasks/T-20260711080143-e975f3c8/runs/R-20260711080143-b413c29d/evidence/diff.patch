+++      <div className="flex items-center gap-1 flex-wrap">
+++        <button
+++          type="button"
+++          onClick={() => setFilterKind(null)}
+++          className={cn(
+++            "border px-2.5 py-0.5 text-xs font-medium transition-colors",
