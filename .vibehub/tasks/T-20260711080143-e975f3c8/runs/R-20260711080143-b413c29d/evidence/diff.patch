+++++            nodes: flowNodes.filter(n => (n.data as unknown as PlanNodeData).state === "active").length > 0 
+++++              ? flowNodes.filter(n => (n.data as unknown as PlanNodeData).state === "active")
+++++              : undefined,
+++++            padding: 1, 
+++++            minZoom: 0.8, 
+++++            maxZoom: 1 
+++++          }}
