++++export function ArchitectureMap({ data, onModuleClick }: ArchitectureMapProps) {
++++  const [selectedEdgeId, setSelectedEdgeId] = useState<string | null>(null);
++++  const [hoveredModule, setHoveredModule] = useState<string | null>(null);
