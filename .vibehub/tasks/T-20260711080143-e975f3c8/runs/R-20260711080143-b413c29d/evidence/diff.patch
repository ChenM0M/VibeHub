++  `task_id: ${taskId}`,
++  "title: MCP contract",
++  "intent: Verify the minimal recovery loop",
++  "phase: implement",
++  "phase_status: active",
++  "acceptance_criteria:",
++  "- MCP recovery loop passes",
++  "dependencies: []",
++  "",
