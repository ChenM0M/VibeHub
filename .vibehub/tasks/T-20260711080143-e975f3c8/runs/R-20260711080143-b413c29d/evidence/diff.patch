+++                <CriterionBadge criterion={criterion} />
+++                <span className="text-sm font-medium">{criterion.title}</span>
+++              </div>
+++              <EvidenceLink evidenceRefs={criterion.evidence_refs} />
+++            </div>
+++          ))}
+++        </div>
+++      )}
+++    </div>
+++  );
+++}
