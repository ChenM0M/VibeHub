++++            filterKind === null ? "border-foreground bg-foreground/5 text-foreground" : "border-transparent text-muted-foreground hover:text-foreground",
++++          )}
++++        >
++++          全部
++++        </button>
++++        {allKinds.map((kind) => (
++++          <button
++++            key={kind}
++++            type="button"
++++            onClick={() => setFilterKind(filterKind === kind ? null : kind)}
