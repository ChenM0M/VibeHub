+        <span className={cn("border border-border/70 px-1.5 py-0.5", freshnessTone[freshness])}>
+          {freshnessLabelMap[freshness]}
+        </span>
+      )}
+      {completeness && (
+        <span className={cn("border border-border/70 px-1.5 py-0.5", completenessTone[completeness])}>
