+pub const MAX_PAGE_SIZE: usize = 500;
+const SNAPSHOT_SCHEMA: u32 = 1;
+const ANALYZER_REGISTRY_VERSION: &str = "project-intelligence-1";
+const IGNORED_DIRS: &[&str] = &[
+    ".git",
+    ".next",
+    ".turbo",
+    ".vite",
+    ".cache",
+    "build",
