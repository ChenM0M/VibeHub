+
+const scenarioSpecs = [
+  ["FX-EMPTY", ["M0-C02", "M0-C03", "M0-C06", "M0-C07"], ["macos", "windows"], "empty"],
+  ["FX-HAPPY", ["M0-C01", "M0-C02", "M0-C07", "M0-C11"], ["neutral"], "happy"],
+  ["FX-NO-DOCS", ["M0-C03", "M0-C06", "M0-C11"], ["neutral"], "no_docs"],
